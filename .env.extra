# Gram Chain explorer configuration.
#
# Layered OVER the instance config fetched at startup (`pnpm dev:preset gcc` fetches
# https://gccscan.com/node-api/config), by both the dev server and the container entrypoint.
# Holds the Gram Chain branding, theme, and the switches that remove ads and outbound links.
# No secrets here (use .env.secrets, git-ignored). Personal overrides go in .env.local (git-ignored).
# Do not use '#' inside values: dotenv treats it as the start of a comment (use rgb() for colours).

# Branding
NEXT_PUBLIC_NETWORK_LOGO=file://./branding/gramchain-logo-light.png
NEXT_PUBLIC_NETWORK_LOGO_DARK=file://./branding/gramchain-logo-dark.png
NEXT_PUBLIC_NETWORK_ICON=file://./branding/gramchain-icon.png
NEXT_PUBLIC_NETWORK_ICON_DARK=file://./branding/gramchain-icon.png
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false
NEXT_PUBLIC_OG_IMAGE_URL=
NEXT_PUBLIC_COLOR_THEME_DEFAULT=light
NEXT_PUBLIC_NAVIGATION_LAYOUT=horizontal
# keep our design over gccscan.com's own colour/font overrides
NEXT_PUBLIC_COLOR_THEME_OVERRIDES=
NEXT_PUBLIC_FONT_FAMILY_BODY=
NEXT_PUBLIC_FONT_FAMILY_HEADING=

# Ads (banner + text) disabled
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_BANNER_ADDITIONAL_PROVIDER=
NEXT_PUBLIC_AD_BANNER_ENABLE_SPECIFY=false
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# External links, promos and Blockscout-hosted services removed
NEXT_PUBLIC_FOOTER_LINKS=
NEXT_PUBLIC_FEATURED_NETWORKS=
NEXT_PUBLIC_FEATURED_NETWORKS_ALL_LINK=
NEXT_PUBLIC_OTHER_LINKS=
NEXT_PUBLIC_NETWORK_EXPLORERS=
NEXT_PUBLIC_VIEWS_NFT_MARKETPLACES=
NEXT_PUBLIC_CONTRACT_CODE_IDES=
NEXT_PUBLIC_ADDRESS_3RD_PARTY_WIDGETS=
NEXT_PUBLIC_ADDRESS_3RD_PARTY_WIDGETS_CONFIG_URL=
NEXT_PUBLIC_MAINTENANCE_ALERT_MESSAGE=
NEXT_PUBLIC_HOMEPAGE_HIGHLIGHTS_CONFIG=
NEXT_PUBLIC_NAVIGATION_PROMO_BANNER_CONFIG=
NEXT_PUBLIC_NAVIGATION_HIGHLIGHTED_ROUTES=
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_MARKETPLACE_BANNER_CONTENT_URL=
NEXT_PUBLIC_MARKETPLACE_BANNER_LINK_URL=
NEXT_PUBLIC_MARKETPLACE_CATEGORIES_URL=
NEXT_PUBLIC_MARKETPLACE_ESSENTIAL_DAPPS_CONFIG=
NEXT_PUBLIC_MARKETPLACE_SUBMIT_FORM=
NEXT_PUBLIC_MARKETPLACE_SUGGEST_IDEAS_FORM=
NEXT_PUBLIC_DEFI_DROPDOWN_ITEMS=
NEXT_PUBLIC_REWARDS_SERVICE_API_HOST=
NEXT_PUBLIC_IS_ACCOUNT_SUPPORTED=false
NEXT_PUBLIC_PRO_API_SUPPORTED=false
NEXT_PUBLIC_GAS_REFUEL_PROVIDER_CONFIG=
NEXT_PUBLIC_MULTICHAIN_BALANCE_PROVIDER_CONFIG=
NEXT_PUBLIC_GAME_BADGE_CLAIM_LINK=
NEXT_PUBLIC_PUZZLE_GAME_BADGE_CLAIM_LINK=
NEXT_PUBLIC_XSTAR_SCORE_URL=
NEXT_PUBLIC_BEACON_CHAIN_VALIDATOR_URL_TEMPLATE=
NEXT_PUBLIC_API_KEYS_ALERT_MESSAGE=
NEXT_PUBLIC_API_DOCS_ALERT_MESSAGE=
NEXT_PUBLIC_TOKEN_INFO_EXPEDITED_REVIEW_HTML=
NEXT_PUBLIC_METASUITES_ENABLED=false
NEXT_PUBLIC_VIEWS_CONTRACT_SOLIDITYSCAN_ENABLED=false
NEXT_PUBLIC_HAS_CONTRACT_AUDIT_REPORTS=false

# Blockscout's analytics / monitoring keys removed so Gramchain traffic is not reported to them
NEXT_PUBLIC_GOOGLE_ANALYTICS_PROPERTY_ID=
NEXT_PUBLIC_MIXPANEL_PROJECT_TOKEN=
NEXT_PUBLIC_MIXPANEL_CONFIG_OVERRIDES=
NEXT_PUBLIC_GROWTH_BOOK_CLIENT_KEY=
NEXT_PUBLIC_ROLLBAR_CLIENT_TOKEN=

# Hero search bar: visible border on the white hero
NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG={'search':{'background':['rgb(255,255,255)','rgb(20,21,24)'],'border_width':['1px','1px'],'border_color':{'_empty':['rgb(212,212,212)','rgb(64,64,64)'],'_hover':['rgb(82,82,82)','rgb(163,163,163)'],'_focus':['rgb(23,23,23)','rgb(245,245,245)'],'_filled':['rgb(212,212,212)','rgb(64,64,64)']}}}

# gccscan.com only accepts secure websockets
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss
